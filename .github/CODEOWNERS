# Review routing only - this file is NOT a security boundary and does not by
# itself enforce review (branch protection decides whether code-owner approval
# is required). Paths not listed here have no special owner; in particular
# individual recipes are intentionally unowned so ordinary contributions stay
# easy to review. Keep this list limited to high-blast-radius surfaces.

# Workflows, including the reusable smoke-test.yml release verification
# contract that sibling repositories call
/.github/workflows/ @yeongseon @paikend
# Composite actions called by ci.yml (PR smoke)
/.github/actions/ @yeongseon @paikend

# Dependency update policy and this file itself
/.github/dependabot.yml @yeongseon @paikend
/.github/CODEOWNERS @yeongseon @paikend

# Security reporting policy
/SECURITY.md @yeongseon @paikend

# Shared validation and golden-output infrastructure
/Makefile @yeongseon @paikend
/scripts/ @yeongseon @paikend
/tests/ @yeongseon @paikend
# Shared CI container image selection and the pinned Ruff rule set
/docker-compose.yml @yeongseon @paikend
/pyproject.toml @yeongseon @paikend

# Recipe-specific tests under tests/ stay unowned like their recipe
# (a later rule with no owner overrides /tests/ above).
/tests/test_ai_agent*.py
